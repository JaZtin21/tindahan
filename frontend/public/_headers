/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/manifest.webmanifest
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=0, must-revalidate
/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=0, must-revalidate